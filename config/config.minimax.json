  "bash_policy": {
    "enabled": true,
    "_comment": "Bash command policy: deny_commands/deny_paths are checked before any shell spawn. The model can override any deny with `escalate: true` in the bash tool args; the override is recorded in the result. allow_commands, when non-empty, becomes a strict whitelist; leave empty to permit any non-denied command. strict_deny_only=true skips the default deny list and uses only what you set here.",
    "deny_commands": [
      "format",
      "diskpart",
      "fdisk",
      "mkfs",
      "dd",
      "sudo",
      "su",
      "runas",
      "shutdown",
      "reboot",
      "halt",
      "poweroff",
      "init",
      "netsh",
      "iptables"
    ],
    "deny_paths": [
      "C:\\Windows",
      "C:\\Windows\\System32",
      "C:\\Program Files",
      "C:\\Program Files (x86)",
      "/etc",
      "/boot",
      "/usr/bin",
      "/usr/sbin",
      "/sbin"
    ]
  },
  "tools_schemas": "config/tools/schemas.json",
  "max_steps": 60,
  "skills": [
    {
      "name": "deep-research",
      "description": "当用户提出深度调研、报告生成等请求时使用。请求技能要求先澄清需求，再由主线程拆步骤、按步骤分发子任务，最后由主线程统一综合，并按交付形态决定直接回复或文件成文。",
      "location": "/skills/deep-research"
    },
    {
      "name": "document-writing",
      "description": "当任务进入结构化文档的成文阶段时使用，例如报告、proposal、spec、decision doc、研究报告最终撰写、长篇结构化 Markdown。仅在 writing / final synthesis 阶段触发，不用于前期搜索、取证、subtask 材料收集。",
      "location": "/skills/document-writing"
    },
    {
      "name": "ppt-maker",
      "description": "当用户需要新建整套 PPT、继续已有 PPT 工件、或从上游半成品报告启动 PPT 生成时使用。用户要求制作PPT时，必须立即读取此skill。此skill负责汇总任务信息，整理参考数据，然后分发到对应的制作模式 Skill。",
      "location": "/skills/ppt-maker"
    },
    {
      "name": "ppt-no-template-mode",
      "description": "当 PPT 任务已确认使用无模板模式（ppt_mode=no-template），且 task_pack.json、info_pack.json 和 deck 工作目录均就绪时使用。负责设计信息生成、大纲生成、资产规划、逐页 HTML 生成和 review/rewrite 全链路。只要 ppt-maker 分发到无模板模式，都必须进入本 Skill。",
      "location": "/skills/ppt-no-template-mode"
    },
    {
      "name": "ppt-template-mode",
      "description": "当 PPT 任务已确认使用模板模式（ppt_mode=template），且 task_pack.json、info_pack.json、模板配置文件和模板 HTML 目录均就绪时使用。负责模板编排、大纲生成、资产规划和逐页 HTML 生成全链路。只要 ppt-maker 分发到模板模式，都必须进入本 Skill。",
      "location": "/skills/ppt-template-mode"
    },
    {
      "name": "ppt-creative-mode",
      "description": "当 PPT 任务确认使用创意模式（ppt_mode=creative），且 task_pack.json / info_pack.json / deck 工作目录均就绪时使用。负责风格生成、大纲生成、逐页并发调用 creative_page_render API 出图的全链路。只要 ppt-maker 分发到创意模式，都必须进入本 Skill。",
      "location": "/skills/ppt-creative-mode"
    }
  ],
  "reflection": {
    "enabled": false
  },
  "tools": {
    "_comment": "生产工具配置兼容字段。当前本地 Agent 直接消费 readFile；pptTools（如配置）会传给本地环境工具。其余服务能力通过 unifiedToolService 调用，不再自动转换为旧 TOOL_* 子进程环境变量。",
    "fetchUrl": {
      "_comment": "fetch_url 的生产摘要模型兼容字段。当前本地 mock 仅返回确定性协议结果；真实摘要行为由接入的 HTTP 服务实现。",
      "summaryModelName": "MaaS_Cl_Sonnet_46_Multi_Modal",
      "summaryModelBaseUrl": "https://clotho-test.xiaohuanxiong.com/v2/llm"
    },
    "readFile": {
      "_comment": "read_file 大文件【分段读取】配置：文件超过 segmentReadMaxTokens 时按段读，防止单次返回过大撑爆上下文；超过 maxReadFileSizeBytes(10MB) 不直读",
      "segmentReadMaxTokens": 8192,
      "segmentReadMinTokens": 200,
      "maxReadFileSizeBytes": 10485760
    },
    "imageVQA": {
      "_comment": "image_vqa 的服务侧模型配置；本地需接可达 HTTP 服务，mock 仅用于协议验证。",
      "modelName": "dataanalysis-wangsu-claude-sonnet-46-multimodal"
    },
    "documentParser": {
      "_comment": "document_parser【文档解析】真实后端 API：serviceUrl 是解析服务，parserEndpoint 是 uniparse 解析端点；均为生产 k8s 内网地址，本地接入需换可达地址",
      "serviceUrl": "http://python-tool-server:3002",
      "parserEndpoint": "http://headless-svc-uniparse-app.knowledge:8000",
      "uploadDir": "document_parser",
      "outputMaxTokens": 4000,
      "outputTruncateStrategy": "middle",
      "tableMaxDisplayRows": 10
    },
    "rerank": {
      "_comment": "rerank【知识库重排】服务（生产内网，本地知识库流程一般用不到）",
      "serviceUrl": "http://rerank-inner.knowledge.svc.cluster.local:44444",
      "chunkMinTokens": 200,
      "chunkOverlapTokens": 0,
      "topK": 10,
      "threshold": 0.2
    }
  },
  "_comment": "Fairy MiniMax-Text-01 config; api_key resolved from repo root MINIMAX_key.txt"
}
